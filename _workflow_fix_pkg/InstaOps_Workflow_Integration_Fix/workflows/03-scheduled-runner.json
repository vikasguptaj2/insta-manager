    {
      "parameters": {
        "jsCode": "var claimed = $('CODE | Validate Claimed Row & Build Dispatch').first().json;\nvar raw = $input.first().json || {};\nvar netErr = Boolean(raw.error && raw.statusCode === undefined);\nvar sc = raw.statusCode !== undefined ? Number(raw.statusCode) : (netErr ? 0 : 200);\nvar body = raw.body !== undefined ? raw.body : raw;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (_) { body = {}; } }\nbody = body || {};\nif (!netErr && sc >= 200 && sc < 300 && body.accepted === true) {\n  return [{ json: { status: 'ACCEPTED', post_uuid: claimed.post_uuid, post_id: claimed.post_id, execution_id: body.execution_id || '' } }];\n}\nif (!netErr && sc >= 400 && sc < 500) {\n  return [{ json: { status: 'REJECTED_4XX', post_uuid: claimed.post_uuid, lock_key: claimed.lock_key, lock_owner: claimed.lock_owner, job_id: claimed.job_id, detail: JSON.stringify(body).slice(0, 300) } }];\n}\nvar errDetail = netErr ? String(raw.error.message || 'timeout') : ('HTTP ' + sc);\nreturn [{ json: { status: 'UNCERTAIN', post_uuid: claimed.post_uuid, job_id: claimed.job_id, detail: 'Uncertain scheduled W02 dispatch: ' + errDetail } }];"
      },
