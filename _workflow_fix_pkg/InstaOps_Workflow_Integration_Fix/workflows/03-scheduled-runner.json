      "parameters": {
        "jsCode": "// Safeguard marker: INSTAOPS_V2_SCHEDULE — gates SCHEDULING_ENABLED + LIVE_PUBLISH_ENABLED before calling instaops_claim_due_scheduled_posts on Supabase instaops_posts.\nfunction readCfg(key, fallback) {\n  var blocked = false;\n  try {\n    if (typeof $vars !== 'undefined' && $vars && $vars[key] !== undefined && $vars[key] !== null && $vars[key] !== '') {\n      return { value: String($vars[key]), blocked: false };\n    }\n  } catch (_) {}\n  try {\n    if (typeof $env !== 'undefined' && $env && $env[key] !== undefined && $env[key] !== null && $env[key] !== '') {\n      return { value: String($env[key]), blocked: false };\n    }\n  } catch (_) { blocked = true; }\n  return { value: fallback || '', blocked: blocked };\n}\n\nvar schedEnabled = ({value: 'false', source: 'operator-disabled', blocked: false}).value.toLowerCase() === 'true';\nvar livePubEnabled = ({value: 'false', source: 'operator-disabled', blocked: false}).value.toLowerCase() === 'true';\nvar execId = String((typeof $execution !== 'undefined' && $execution && $execution.id) || Date.now());\nreturn [{\n  json: {\n    enabled: schedEnabled && livePubEnabled,\n    worker_id: 'w03:' + execId,\n    sb_url: readCfg('SUPABASE_URL', 'https://cdgwdlhesgcxmswsamrj.supabase.co').value.replace(/\\/$/, ''),\n    n8n_url: readCfg('N8N_BASE_URL', 'https://137.23.61.127.sslip.io').value.replace(/\\/$/, ''),\n    default_ig_user_id: readCfg('INSTAGRAM_USER_ID', '17841453414532595').value\n  }\n}];"
      },
