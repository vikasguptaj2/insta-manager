{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "dom"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "resolveJsonModule": true,
    "outDir": ".test-dist",
    "rootDir": ".",
    "sourceMap": false
  },
  "include": ["types/**/*.ts", "lib/**/*.ts", "app/api/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", ".next", ".test-dist", ".server-dist"]
}
