{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "resolveJsonModule": true,
    "outDir": ".server-dist",
    "rootDir": ".",
    "sourceMap": false
  },
  "include": ["types/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", ".next", ".test-dist", ".server-dist"]
}
