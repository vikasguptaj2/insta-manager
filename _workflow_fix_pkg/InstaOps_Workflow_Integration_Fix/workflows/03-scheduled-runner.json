    {
      "parameters": {
        "jsCode": "// Validates claimed SCHEDULED + LATER row (single or 2-10 CAROUSEL) with approved_revision === revision.\nvar cfg = $('CODE | Check Schedule Gate & Read Config').first().json;\nvar raw = $input.first().json || {};\nvar sc = raw.statusCode !== undefined ? Number(raw.statusCode) : (raw.error ? 0 : 200);\nvar body = raw.body !== undefined ? raw.body : raw;\nvar rows = !raw.error && sc < 300 && Array.isArray(body) ? body : [];\nif (!rows.length) {\n  return [{ json: { outcome: 'NONE' } }];\n}\nvar row = rows[0];\nvar mediaType = String(row.media_type || 'REEL').toUpperCase();\nvar activeAssets = Array.isArray(row.media_items) ? row.media_items : [];\nvar rev = Number(row.revision || 0);\nvar appRev = Number(row.approved_revision || 0);\nif (!rev || appRev !== rev || (mediaType === 'CAROUSEL' && (activeAssets.length < 2 || activeAssets.length > 10))) {\n  return [{ json: { outcome: 'PRECHECK_FAIL', post_uuid: String(row.post_uuid), lock_key: String(row.lock_key), lock_owner: String(row.lock_owner), job_id: String(row.job_id || '') } }];\n}\nreturn [{\n  json: {\n    outcome: 'DISPATCH',\n    post_uuid: String(row.post_uuid),\n    post_id: String(row.post_id),\n    lock_key: String(row.lock_key),\n    lock_owner: String(row.lock_owner),\n    job_id: String(row.job_id),\n    request_id: String(row.request_id),\n    dispatch_body: {\n      action: 'PUBLISH',\n      post_uuid: String(row.post_uuid),\n      post_id: String(row.post_id),\n      ig_user_id: String(row.ig_user_id || cfg.default_ig_user_id),\n      media_type: mediaType,\n      caption: String(row.caption || ''),\n      media_url: String(row.media_url || ''),\n      reviewed_revision: String(rev),\n      approved_revision: String(appRev),\n      confirm: true,\n      lock_key: String(row.lock_key),\n      lock_owner: String(row.lock_owner),\n      job_id: String(row.job_id),\n      request_id: String(row.request_id)\n    }\n  }\n}];"
      },
