# =================================================
# InstaOps v2.0 — Advanced Instagram Manager (Supabase Primary DB)
# Copy to .env.local and fill your own keys and rotated secrets.
# NEVER commit .env.local or expose SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_* vars.
# =================================================

APP_NAME=InstaOps
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://127.0.0.1:3000
DEMO_MODE=false

# Supabase (Primary Source of Truth)
# NEXT_PUBLIC_* vars contain ONLY public URL and publishable anon key.
NEXT_PUBLIC_SUPABASE_URL=https://cdgwdlhesgcxmswsamrj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://cdgwdlhesgcxmswsamrj.supabase.co
SUPABASE_ANON_KEY=
# SERVER-ONLY secret — never prefix with NEXT_PUBLIC_ and never expose to browser!
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI (optional if using Supabase REST/RPC only; useful for CLI SQL verification)
DATABASE_URL=

# Online n8n server (rotate previous keys; never reuse legacy Docker tokens)
N8N_BASE_URL=https://137.23.61.127.sslip.io
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# Online n8n workflow IDs (populate after importing n8n/workflows/01..05.json)
N8N_EXTRACT_WORKFLOW_ID=
N8N_PUBLISH_WORKFLOW_ID=
N8N_SCHEDULE_WORKFLOW_ID=
N8N_CONTENT_WORKFLOW_ID=
N8N_RECOVERY_WORKFLOW_ID=

# Online n8n production webhook paths
N8N_EXTRACT_PATH=instaops-extract-v1
N8N_PUBLISH_PATH=instaops-publish-v1
N8N_CONTENT_PATH=instaops-content-v1
N8N_RECOVERY_PATH=instaops-recovery-v1

# Hosted Instagram downloader (Vercel)
DOWNLOADER_BASE_URL=https://ig-dowloader-nnnn.vercel.app
DOWNLOADER_API_KEY=

# Instagram account (@vikas.sphere)
INSTAGRAM_ACCOUNT_LABEL=@vikas.sphere
INSTAGRAM_USER_ID=17841453414532595
INSTAGRAM_GRAPH_VERSION=v22.0

# Google Sheets (Synchronized Reporting Layer — keyed by permanent UUID / post_id)
SHEETS_SYNC_ENABLED=true
GOOGLE_SHEET_ID=19kurWKXLoijsf29tKzedhRHbbg7g9qiSZkcjUszHRhs
GOOGLE_SHEET_GID=18819980
GOOGLE_SHEET_MAIN_TAB=Posts
GOOGLE_SHEET_ASSETS_TAB=MediaAssets
GOOGLE_SHEET_LOGS_TAB=ExecutionLogs
GOOGLE_SHEET_ACCOUNTS_TAB=Accounts

# Cloudinary (Authoritative media object storage)
CLOUDINARY_CLOUD_NAME=djkkknb9k

# Durable coordination backend ('supabase' | 'postgres' | 'local')
ATOMIC_LOCK_PROVIDER=supabase

# Safety feature gates (keep disabled until SQL migration, n8n workflows and keys are verified)
SCHEDULING_ENABLED=false
BULK_PUBLISH_ENABLED=false
AI_CAPTION_ENABLED=false
LIVE_PUBLISH_ENABLED=false
LIVE_DELETE_ENABLED=false
PUBLIC_ACCESS_ENABLED=false
